# Path overrides (defaults are relative to repo root)
# REPRO_ROOT=/path/to/ICLR/repro
# DATA_DIR=/path/to/ICLR/data
# RESULTS_DIR=/path/to/ICLR/results
# CACHE_DIR=/path/to/your/cache

# HuggingFace access token (required for gated models: Llama, Qwen)
# Get one at https://huggingface.co/settings/tokens
# HF_TOKEN=

# CUDA device selection (optional)
# CUDA_VISIBLE_DEVICES=0
