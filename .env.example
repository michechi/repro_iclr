# Optional shell environment template; not automatically loaded.
# Supply credentials locally only when required. Never commit a filled copy.
HF_TOKEN=
# SCRATCH: writable scratch root used by the legacy top-level trainers
# (src/experiments/*_fraction_experiment*.py, src/experiments/parity_decomposition_llm.py,
# src/mimic/train_mimic.py) for model caches and intermediate outputs. Defaults to /tmp.
# SCRATCH=/path/to/writable/scratch
# HF_HUB_CACHE: standard Hugging Face cache override, honored wherever pretrained
# models are loaded (both packages). Model caches are not distributed.
# HF_HUB_CACHE=/path/to/local/model/cache
# The MIMIC_* variables below apply only to the nested repro/ package
# (read in repro/src/common.py); the top-level src/ package does not read them.
# Set them to your own authorized data directories:
# MIMIC_RAW=/path/to/authorized/mimic/raw
# MIMIC_PROCESSED=/path/to/authorized/mimic/processed
# MIMIC_TRAINING=/path/to/authorized/mimic/training
